{
  "name": "@bayinformatics/croppie",
  "version": "3.2.0",
  "description": "A modern, TypeScript-first image cropper. Fork of Foliotek/Croppie.",
  "type": "module",
  "main": "./dist/croppie.js",
  "module": "./dist/croppie.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/croppie.js",
      "default": "./dist/croppie.js"
    },
    "./croppie.css": {
      "types": "./dist/croppie.css.d.ts",
      "default": "./dist/croppie.css"
    },
    "./style.css": {
      "types": "./dist/croppie.css.d.ts",
      "default": "./dist/croppie.css"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/croppie.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "dev": "bun build src/index.ts --outdir=dist --entry-naming=croppie.[ext] --watch",
    "build": "bun run clean && bun run build:js && bun run build:css && bun run build:types",
    "build:js": "bun build src/index.ts --outdir=dist --entry-naming=croppie.[ext] --minify --sourcemap",
    "build:docs": "bun build src/index.ts --outdir docs --entry-naming croppie.[ext] --minify --sourcemap && cp src/croppie.css docs/croppie.css",
    "build:css": "cp src/croppie.css dist/croppie.css && echo 'export {};' > dist/croppie.css.d.ts",
    "build:types": "tsc -p tsconfig.json",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:visual": "bun run build && bunx playwright test",
    "test:all": "bun run build && bun run test && bunx playwright test",
    "test:watch": "bun test --watch",
    "lint": "biome check src tests scripts playwright.config.ts",
    "lint:fix": "biome check --write src tests scripts playwright.config.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "check:package": "node scripts/check-dts-specifiers.mjs && publint --strict --pack bun && node scripts/check-types-wrong.mjs",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "image",
    "crop",
    "cropper",
    "avatar",
    "resize",
    "canvas",
    "typescript"
  ],
  "author": "Bay Informatics",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bayinformatics/croppie.git"
  },
  "bugs": {
    "url": "https://github.com/bayinformatics/croppie/issues"
  },
  "homepage": "https://bayinformatics.github.io/croppie/",
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "happy-dom": "20.14.5",
    "publint": "0.3.25",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
